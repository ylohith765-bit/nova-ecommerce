# ==============================================================================
# NOVA E-COMMERCE .GITIGNORE
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build and cache output
/.next/
/out/
/build

# Testing coverage
/coverage

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging
!.env.example

# Debug and package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System and Editor files
.DS_Store
*.pem
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma & local SQLite databases
*.db
*.db-journal
